@startuml dsd_uc4_logIn
title DSD UC4 Start Up - logIn(employeeID, pin) (Contract 17)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 10
skinparam BoxPadding 6
skinparam NoteBackgroundColor #FFFBE6
skinparam NoteBorderColor #B7791F
hide footbox
box "ui.api" #EAF2E3
  participant "ctrl:SessionController" as C
end box
box "application" #E8EEF7
  participant "h:SessionHandler" as H
end box
box "domain" #FFF7E0
  participant "store:Store" as ST
end box
box "technical.storage" #F2F2F2
  participant "employees:EmployeeList" as EL
end box
box "technical.external" #F6EDF7
  participant "HRSystemAdapter" as HA
end box
box "external system (stub)" #FFFFFF
  participant "HR System" as HR
end box

[-> C : POST /api/sessions {employeeID, pin}
C -> H : logIn(employeeID, pin)
H -> HA : checkEmployee(employeeID, pin)
HA -> HR : POST /employees/check
HR --> HA : {valid, active, name, role}
HA --> H : EmployeeCheck
alt VALID (HR System answered)
  H -> H : accepted = role is cashier
  note right : a store manager or another role\nis refused as in 6a
else INVALID: not found, not active or wrong PIN (6a, 6b)
  H -> H : accepted = false
else NOT_AVAILABLE: local employee list (6c, IR-09)
  H -> EL : lastUpdate()
  EL --> H : Optional<dateTime>
  alt no local list (6c2)
    H -> H : accepted = false, reason NO_LOCAL_LIST
  else list exists
    H -> EL : find(employeeID)
    EL --> H : Optional<EmployeeEntry>
    alt not in the local list (6c1)
      H -> H : accepted = false (as 6a)
    else entry found
      H -> H : accepted = entry.isActiveCashier()\nand entry.pinMatches(pin) (salted hash, DR-11)
      note right : false when the PIN differs (6c3, as 6b)
    end
  end
end
alt accepted
  H -> ST : findEmployee(employeeID)
  ST --> H : employee
  H -> H : pendingCashier = employee
  note right of H : login in progress: the cashier waits here for the opening cash\n(enterOpeningCash). No CashierSession exists yet and the\ndomain model has no Employee-Register association
  H --> C : LoginResult(OK, cashierName, localListUsed, lastUpdate)
  C -->[ : 201 cashier name, request for the opening cash\n(warning with the date and time of the last update when the local list was used, 6c)
else refused
  H --> C : LoginResult(REFUSED, reason)
  C -->[ : 403 message for the cashier (NFR-14)
end
note over H : The pin is only a parameter of the checks:\nnever stored, logged or returned (NFR-08)
@enduml