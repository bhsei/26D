@startuml
' NewEra POS - Design class diagram, skeleton 3 of 3: interfaces and technical services (names only), W11
' Team D - editable source of assets/design_classes_technical.png
' Render with: java -jar plantuml.jar -tpng -charset UTF-8 assets/design_classes_technical.puml
' Sources: logical view (architecture.md 4.2), domain model v0.7, AD-08, system_interfaces.md v0.5 (4.1 to 4.3).
' The skeleton has class names, packages and the main links. Attributes and methods are added from the
' design sequence diagrams (Mon 23 Nov). The UI screens are in assets/ui_classes.puml (ui_design.md 4).

set separator none
skinparam shadowing false
skinparam dpi 110
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 20
skinparam ranksep 60
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B8A04A
skinparam class {
  BackgroundColor<<controller>> #EAF6EA
  BorderColor<<controller>> #2E7D32
  BackgroundColor<<handler>> #F4F8FD
  BorderColor<<handler>> #1F4E79
  BackgroundColor<<payment>> #EAF1FB
  BorderColor<<payment>> #1F4E79
  BackgroundColor<<domain>> #FFFFFF
  BorderColor<<domain>> #666666
  BackgroundColor<<interface>> #EAF1FB
  BorderColor<<interface>> #1F4E79
  BackgroundColor<<impl>> #F4F4F4
  BorderColor<<impl>> #666666
  BackgroundColor<<result>> #FFFFFF
  BorderColor<<result>> #999999
}
hide circle
hide members
left to right direction

title NewEra POS - Design class diagram (skeleton 3 of 3): interfaces and technical services

package "application (helpers that use the interfaces; the handlers use them too)" {
  class ManagerApproval <<handler>>
  class AccountingSender <<handler>>
  class CashPaymentMethod <<payment>>
  class CreditCardPaymentMethod <<payment>>
  class CheckPaymentMethod <<payment>>
}

package "application.interfaces" {
  interface PaymentService <<interface>>
  interface TaxCalculator <<interface>>
  interface AccountingSystem <<interface>>
  interface HRSystem <<interface>>
  interface CatalogSource <<interface>>
  interface CardReader <<interface>>
  interface ReceiptPrinter <<interface>>
  interface CashDrawer <<interface>>
  interface TransactionRepository <<interface>>
  interface SessionRepository <<interface>>
  interface SettingsRepository <<interface>>
  interface ItemRepository <<interface>>
  interface EmployeeList <<interface>>
  interface AccountingQueue <<interface>>
  interface StoreDatabaseSync <<interface>>
}

package "technical.external" {
  class PaymentServiceAdapter <<impl>>
  class TaxCalculatorAdapter <<impl>>
  class AccountingSystemAdapter <<impl>>
  class HRSystemAdapter <<impl>>
  class CatalogSourceAdapter <<impl>>
}

package "technical.devices" {
  class CardReaderDriver <<impl>>
  class ReceiptPrinterDriver <<impl>>
  class CashDrawerDriver <<impl>>
}

package "technical.storage" {
  class SqliteTransactionRepository <<impl>>
  class SqliteSessionRepository <<impl>>
  class SqliteSettingsRepository <<impl>>
  class SqliteItemRepository <<impl>>
  class SqliteEmployeeList <<impl>>
  class SqliteAccountingQueue <<impl>>
  class JdbcStoreDatabaseSync <<impl>>
}

package "technical.logging" {
  class EventLog <<impl>>
}

' ---------- implementations (dependency inversion, AD-01) ----------
PaymentService <|.. PaymentServiceAdapter
TaxCalculator <|.. TaxCalculatorAdapter
AccountingSystem <|.. AccountingSystemAdapter
HRSystem <|.. HRSystemAdapter
CatalogSource <|.. CatalogSourceAdapter
CardReader <|.. CardReaderDriver
ReceiptPrinter <|.. ReceiptPrinterDriver
CashDrawer <|.. CashDrawerDriver
TransactionRepository <|.. SqliteTransactionRepository
SessionRepository <|.. SqliteSessionRepository
SettingsRepository <|.. SqliteSettingsRepository
ItemRepository <|.. SqliteItemRepository
EmployeeList <|.. SqliteEmployeeList
AccountingQueue <|.. SqliteAccountingQueue
StoreDatabaseSync <|.. JdbcStoreDatabaseSync

' ---------- application helpers ----------
AccountingSender ..> AccountingSystem
AccountingSender ..> AccountingQueue
ManagerApproval ..> HRSystem
ManagerApproval ..> EmployeeList
CreditCardPaymentMethod ..> PaymentService
CreditCardPaymentMethod ..> CardReader
CheckPaymentMethod ..> PaymentService
CashPaymentMethod ..> CashDrawer

' ---------- the technical services call each other only in these places ----------
SqliteTransactionRepository ..> SqliteAccountingQueue : same database transaction
JdbcStoreDatabaseSync ..> SqliteTransactionRepository : reads the waiting records
PaymentServiceAdapter ..> EventLog
AccountingSystemAdapter ..> EventLog
HRSystemAdapter ..> EventLog
TaxCalculatorAdapter ..> EventLog
CashDrawerDriver ..> EventLog

note bottom of EventLog
  Request and result classes of the interfaces are in application.interfaces and are not drawn
  (system_interfaces.md 4.1 to 4.3): PaymentRequest, RefundRequest, PaymentResult, TaxRequest,
  TaxResult, Acknowledgement, EmployeeCheck, EmployeeListResult, CatalogImport, CardReadResult,
  PrinterStatus, DrawerStatus, SyncResult, HoldResult, TransactionResult, StoreResult.
  The six handlers use the repositories, TaxCalculator, ReceiptPrinter and CashDrawer.
  The names of the implementations (Sqlite..., Jdbc...) are proposed; the logical view
  lists the classes of technical.storage without a prefix.
end note
@enduml
