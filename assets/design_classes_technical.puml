@startuml
' NewEra POS - Design class diagram 3 of 3 (complete): external systems, devices and logging, W11
' Team D - editable source of assets/design_classes_technical.png
' Render with: java -jar plantuml.jar -tpng -charset UTF-8 assets/design_classes_technical.puml
' Sources: system_interfaces.md section 4 (interfaces), design sequence diagrams of UC1, UC3, UC4 and UC5, AD-01, AD-04, AD-06, AD-07.
' The repositories, the queue and the store database are in assets/design_classes_storage.puml (diagram 3b).

set separator none
skinparam shadowing false
skinparam dpi 100
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 45
skinparam ArrowColor #444444
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B8A04A
skinparam class {
  BackgroundColor<<handler>> #F4F8FD
  BorderColor<<handler>> #1F4E79
  BackgroundColor<<payment>> #EAF1FB
  BorderColor<<payment>> #1F4E79
  BackgroundColor<<interface>> #EAF1FB
  BorderColor<<interface>> #1F4E79
  BackgroundColor<<impl>> #F4F4F4
  BorderColor<<impl>> #666666
}
hide circle
left to right direction

title NewEra POS - Design class diagram (3 of 3): interfaces and technical services (external systems, devices, log)

package "application (members in diagram 1 of 3)" {
  class SessionHandler <<handler>>
  class ManagerHandler <<handler>>
  class SaleHandler <<handler>>
  class ReturnHandler <<handler>>
  class RentalHandler <<handler>>
  class RentalReturnHandler <<handler>>
  class ManagerApproval <<handler>>
  class AccountingSender <<handler>>
  class CashPaymentMethod <<payment>>
  class CreditCardPaymentMethod <<payment>>
  class CheckPaymentMethod <<payment>>
}

package "application.interfaces" {
  interface PaymentService <<interface>> {
    + authorize(request : PaymentRequest) : PaymentResult
    + refund(request : RefundRequest) : PaymentResult
    + refundStatus(transactionID : String) : PaymentResult
    + voidAuthorization(transactionID : String) : PaymentResult
  }
  interface TaxCalculator <<interface>> {
    + calculateTax(request : TaxRequest) : TaxResult
  }
  interface AccountingSystem <<interface>> {
    + send(record : AccountingRecord) : Acknowledgement
  }
  interface HRSystem <<interface>> {
    + checkEmployee(employeeID : String, pin : String) : EmployeeCheck
    + employeeList() : EmployeeListResult
  }
  interface CatalogSource <<interface>> {
    + importCatalog(exportFile : Path, lastImported : CatalogFileInfo) : CatalogImport
  }
  interface CardReader <<interface>> {
    + read() : CardReadResult
  }
  interface ReceiptPrinter <<interface>> {
    + print(receipt : Receipt) : PrinterStatus
  }
  interface CashDrawer <<interface>> {
    + open(reason : DrawerReason, employeeID : String) : DrawerStatus
  }
}

package "technical.external" {
  class PaymentServiceAdapter <<impl>>
  class TaxCalculatorAdapter <<impl>>
  class AccountingSystemAdapter <<impl>>
  class HRSystemAdapter <<impl>>
  class CatalogSourceAdapter <<impl>>
}
package "technical.devices" {
  class CardReaderDriver <<impl>>
  class ReceiptPrinterDriver <<impl>>
  class CashDrawerDriver <<impl>>
}
package "technical.logging" {
  class EventLog <<impl>> {
    + logWarning(message : String, details : String) : void
    + logDrawerOpening(time : DateTime, employeeID : String, reason : DrawerReason) : void
    + logFailedAttempt(system : String, time : DateTime, error : String) : void
  }
}

PaymentService <|.. PaymentServiceAdapter
TaxCalculator <|.. TaxCalculatorAdapter
AccountingSystem <|.. AccountingSystemAdapter
HRSystem <|.. HRSystemAdapter
CatalogSource <|.. CatalogSourceAdapter
CardReader <|.. CardReaderDriver
ReceiptPrinter <|.. ReceiptPrinterDriver
CashDrawer <|.. CashDrawerDriver

' ---------- who uses the interfaces ----------
SessionHandler --> CatalogSource
SessionHandler --> HRSystem
SessionHandler --> PaymentService : voidAuthorization
SessionHandler --> CashDrawer
SessionHandler --> ReceiptPrinter : reprints
ManagerHandler --> CatalogSource : importCatalog
SessionHandler --> EventLog
SaleHandler --> TaxCalculator
SaleHandler --> ReceiptPrinter
RentalHandler --> TaxCalculator
RentalHandler --> ReceiptPrinter
RentalReturnHandler --> TaxCalculator
RentalReturnHandler --> ReceiptPrinter
ReturnHandler --> ReceiptPrinter
ManagerApproval --> HRSystem
AccountingSender --> AccountingSystem
CreditCardPaymentMethod --> PaymentService
CreditCardPaymentMethod --> CardReader
CheckPaymentMethod --> PaymentService
CashPaymentMethod --> CashDrawer

PaymentServiceAdapter ..> EventLog
AccountingSystemAdapter ..> EventLog
HRSystemAdapter ..> EventLog
TaxCalculatorAdapter ..> EventLog
CashDrawerDriver ..> EventLog
AccountingSender ..> EventLog

note bottom of EventLog
  The adapters apply the timeout (AD-07): Payment Service 10 s, Tax Calculator 5 s, HR System 5 s,
  Accounting System 5 s, catalog import: timeout of the Settings (10 s, in the background). The handler decides the fallback. Request and result classes are in
  application.interfaces and are not drawn (system_interfaces.md 4.1 to 4.3): PaymentRequest, RefundRequest,
  PaymentResult, TaxRequest, TaxResult, Acknowledgement (RECEIVED, REJECTED, NOT_AVAILABLE), EmployeeCheck,
  EmployeeListResult, CatalogImport, CardReadResult, PrinterStatus, DrawerStatus, DrawerReason.
  EventLog.logFailedAttempt comes from AD-06; logWarning is used for a rejected catalog file (dsd_uc4_startUp).
  CatalogImport: NO_NEW_FILE, VALID (with the Catalog and its CatalogFileInfo), REJECTED, NOT_AVAILABLE.
end note
@enduml
