@startuml
' NewEra POS - Design class diagram 1 of 3 (complete): controllers and application layer, W11
' Team D - editable source of assets/design_classes_application.png
' Render with: java -jar plantuml.jar -tpng -charset UTF-8 assets/design_classes_application.puml
' Sources: system_interfaces.md section 3 (operations), design sequence diagrams of UC1 to UC5, review #69, AD-01, AD-06, AD-07, AD-08.
' Visibility: - private, + public. "new" = used by a design sequence diagram and not in the logical view or system_interfaces.md.

set separator none
skinparam shadowing false
skinparam dpi 100
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 45
skinparam ArrowColor #444444
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B8A04A
skinparam class {
  BackgroundColor<<controller>> #EAF6EA
  BorderColor<<controller>> #2E7D32
  BackgroundColor<<handler>> #F4F8FD
  BorderColor<<handler>> #1F4E79
  BackgroundColor<<payment>> #EAF1FB
  BorderColor<<payment>> #1F4E79
  BackgroundColor<<domain>> #FFFFFF
  BorderColor<<domain>> #666666
}
hide circle
left to right direction

title NewEra POS - Design class diagram (1 of 3): controllers and application layer

package "ui.api" {
  class SessionController <<controller>> {
    - handler : SessionHandler
  }
  class SaleController <<controller>> {
    - handler : SaleHandler
  }
  class ReturnController <<controller>> {
    - handler : ReturnHandler
  }
  class RentalController <<controller>> {
    - handler : RentalHandler
  }
  class RentalReturnController <<controller>> {
    - handler : RentalReturnHandler
  }
  class ManagerController <<controller>> {
    - handler : ManagerHandler
  }
}

package "application" {
  class SessionHandler <<handler>> {
    - pendingCashier : Employee «new»
    - register : Register
    + startUp() : StartUpResult
    + logIn(employeeID : String, pin : String) : LoginResult
    + enterOpeningCash(amount : Money) : OpeningResult
    + closeSession() : CloseResult
    + enterClosingCash(amount : Money) : ClosingResult
    + confirmCloseSession() : CloseResult
    + getSystemStatus() : SystemStatus
    + listPendingRefunds() : List<PendingRefund>
    + reprintReceipt(receiptNumber : String) : PrinterStatus
    + reprintLastReceipt() : PrinterStatus
  }
  class SaleHandler <<handler>> {
    - session : CashierSession
    - sale : Sale
    + makeNewSale() : String
    + enterItem(itemID : String, quantity : int) : LineResult
    + removeItem(lineNumber : int) : Money
    + overridePrice(lineNumber : int, newPrice : Money, managerID : String, pin : String) : LineResult
    + endSale() : TotalResult
    + makePayment(amount : Money, tender : TenderType) : PaymentOutcome
    + cancelSale() : void
    + getAvailableTenders() : List<TenderStatus>
  }
  class ReturnHandler <<handler>> {
    - session : CashierSession
    - ret : Return
    + makeNewReturn() : String
    + findSale(receiptNumber : String) : SaleView
    + enterReturnItem(itemID : String, quantity : int, condition : ItemCondition) : ReturnLineResult
    + removeReturnItem(lineNumber : int) : Money
    + confirmReturn() : ConfirmResult «new»
    + approveCashRefund(managerID : String, pin : String, reason : String) : RefundOutcome
    + checkRefundStatus() : RefundOutcome
    + cancelReturn() : void
  }
  class RentalHandler <<handler>> {
    - session : CashierSession
    - rental : Rental
    + makeNewRental() : String
    + enterCustomerID(customerID : String) : CustomerResult
    + registerCustomer() : String
    + enterRentalItem(serialNumber : String) : RentalLineResult
    + selectRentalPeriod(lineNumber : int, days : int) : RentalLineResult
    + endRental() : RentalTotals
    + makePayment(amount : Money, tender : TenderType) : PaymentOutcome
    + cancelRental() : void
  }
  class RentalReturnHandler <<handler>> {
    - session : CashierSession
    - rentalReturn : RentalReturn
    + makeNewRentalReturn() : String
    + findRental(code : String) : RentalData
    + findRentalsOfCustomer(customerID : String) : List<OpenRental>
    + selectRental(rentalID : String) : RentalData
    + recordCondition(condition : ItemCondition, damageNote : String) : ConditionResult
    + confirmDamage(managerID : String, pin : String) : DamageResult
    + makePayment(amount : Money, tender : TenderType) : PaymentOutcome
    + confirmRentalReturn() : ConfirmResult «new»
    + approveCashRefund(managerID : String, pin : String, reason : String) : RefundOutcome
    + checkRefundStatus() : RefundOutcome
    + cancelRentalReturn() : void
  }
  class ManagerHandler <<handler>> {
    + listFlaggedProducts(managerID : String, pin : String) : List<FlaggedProduct>
    + listRentalConflicts(managerID : String, pin : String) : Page<RentalConflict>
    + resolveRentalConflict(conflictID : String, managerID : String, pin : String, reason : String) : StoreResult
    + changeDefaultTaxRate(rate : Decimal, managerID : String, pin : String) : StoreResult
    + disableEmployee(employeeID : String, managerID : String, pin : String) : void
    + enableEmployee(employeeID : String, managerID : String, pin : String) : void
    + listSessionsToReview(managerID : String, pin : String) : Page<SessionToReview>
    + confirmSessionReview(sessionID : String, managerID : String, pin : String, reason : String) : ReviewResult
    + getAccountingQueueStatus(managerID : String, pin : String) : QueueStatus
    + importCatalog(file : Path, managerID : String, pin : String) : StoreResult
  }
  class ManagerApproval <<handler>> {
    + check(managerID : String, pin : String) : ApprovalResult «new»
  }
  class AccountingSender <<handler>> {
    - waitTimes : List<Duration>
    + start() : void
    - sendFirst() : void
    - nextWait(attempts : int) : Duration
  }
  class PaymentMethods <<payment>> {
    + get(tender : TenderType) : PaymentMethod
    + availableTenders() : List<TenderStatus>
  }
  interface PaymentMethod <<payment>> {
    + tenderType() : TenderType
    + pay(t : Transaction, amount : Money) : PaymentOutcome
    + refund(original : Payment, amount : Money, employeeID : String) : RefundOutcome «new»
    + giveUp(t : Transaction) : void «new»
  }
  class CashPaymentMethod <<payment>> {
    - drawer : CashDrawer
  }
  class CreditCardPaymentMethod <<payment>> {
    - reader : CardReader
    - paymentService : PaymentService
    - transactions : TransactionRepository
  }
  class CheckPaymentMethod <<payment>> {
    - paymentService : PaymentService
  }
}

package "domain (diagram 2 of 3)" {
  class Register <<domain>>
  class CashierSession <<domain>>
  class Sale <<domain>>
  class Return <<domain>>
  class Rental <<domain>>
  class RentalReturn <<domain>>
  class Employee <<domain>>
  class Transaction <<domain>>
  class Payment <<domain>>
}

SessionController --> SessionHandler
SaleController --> SaleHandler
ReturnController --> ReturnHandler
RentalController --> RentalHandler
RentalReturnController --> RentalReturnHandler
ManagerController --> ManagerHandler

SessionHandler --> "0..1" Employee : pendingCashier
SessionHandler --> Register
RentalReturnHandler --> Register : currentSession() «new»
SessionHandler ..> AccountingSender : starts
SaleHandler --> "0..1" Sale
ReturnHandler --> "0..1" Return
RentalHandler --> "0..1" Rental
RentalReturnHandler --> "0..1" RentalReturn
SaleHandler ..> CashierSession
ReturnHandler ..> CashierSession
RentalHandler ..> CashierSession
RentalReturnHandler ..> CashierSession

SaleHandler --> ManagerApproval
ReturnHandler --> ManagerApproval
RentalReturnHandler --> ManagerApproval
ManagerHandler --> ManagerApproval
SaleHandler --> PaymentMethods
ReturnHandler --> PaymentMethods
RentalHandler --> PaymentMethods
RentalReturnHandler --> PaymentMethods
PaymentMethods o--> "*" PaymentMethod
PaymentMethod <|.. CashPaymentMethod
PaymentMethod <|.. CreditCardPaymentMethod
PaymentMethod <|.. CheckPaymentMethod
PaymentMethod ..> Payment : creates
PaymentMethod ..> Transaction : pays

note bottom of AccountingSender
  Controllers: one method for each operation of its handler (system_interfaces.md 3). It checks the format of the
  request, calls the handler and turns the result into the HTTP answer; it has no business logic (AD-01).
  The result classes of the handlers (LineResult, TotalResult, PaymentOutcome, RefundOutcome, StartUpResult,
  LoginResult, OpeningResult, CloseResult, ClosingResult, ReviewResult, ApprovalResult...) are not drawn.
  ConfirmResult (refund state, receipt number, printer status, drawer status) is the answer of confirmReturn and confirmRentalReturn.
  The handlers, ManagerApproval, AccountingSender and the payment methods use the interfaces of
  application.interfaces (diagram 3 of 3). findSale also answers SALE_NOT_AVAILABLE (UC2).
end note
@enduml
