@startuml
' NewEra POS - Deployment (physical) view, W09
' Team D - editable source of assets/architecture_deployment.png
' Render with: java -jar plantuml.jar -tpng assets/architecture_deployment.puml
' Names follow docs/design/architecture.md (AD-01 layers, AD-02 local web application, AD-10 devices),
' the domain model (Register) and the SRS (IR-01 to IR-17, DC-01 to DC-09).
' The numbers on the links are the numbers of the table "Network links" in section 4.4.

skinparam shadowing false
skinparam dpi 130
skinparam defaultFontName Arial
skinparam ArrowColor #444444
skinparam ArrowFontSize 12
skinparam nodesep 40
skinparam ranksep 70
skinparam NodeBorderColor #1F4E79
skinparam NodeBackgroundColor #EAF1FB
skinparam ComponentBorderColor #1F4E79
skinparam ComponentBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #1F4E79
skinparam DatabaseBackgroundColor #FFFFFF
skinparam ArtifactBorderColor #444444
skinparam ArtifactBackgroundColor #FFFFFF
skinparam RectangleBorderColor #888888
skinparam RectangleBackgroundColor #FFFFFF
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B8A04A

title NewEra POS - Deployment view

rectangle "Devices of the register" as Devices {
  node "Barcode scanner\n(works as a keyboard)" as Scanner <<device>>
  node "Card reader\n(chip, contactless)" as CardReader <<device>>
  node "Receipt printer\n(thermal)" as Printer <<device>>
  node "Cash drawer" as Drawer <<device>>
}

node "Register computer (one per Register)" as Reg <<device>> {
  node "Browser\n(full screen)\nUI screens" as Browser <<execution environment>>
  component "POS application (Java, local web server)\n\nUI layer: system API\nApplication / domain layer\nTechnical services layer:\nadapters, Device Service,\nlocal storage, logging" as Pos
  database "Local database\nlocal copy, Accounting queue,\nlocal employee list" as Local
}

node "Store database server" as StoreSrv <<device>> {
  database "Store database\n(shared by all registers)" as StoreDB
}

node "Back-office system\n(exports the catalog file)" as BO <<node>>

node "External systems\n(stubs in our project, DC-01)" as Ext <<node>> {
  artifact "Payment Service stub" as PayStub
  artifact "Tax Calculator stub" as TaxStub
  artifact "Accounting System stub" as AccStub
  artifact "HR System stub" as HRStub
}

Scanner -down-> Browser : 1
Browser -down-> Pos : 2
CardReader -down-> Pos : 3
Pos -up-> Printer : 4
Pos -up-> Drawer : 5
Pos -down-> Local : 6
Pos -down-> StoreDB : 7
Pos -down-> PayStub : 8
Pos -down-> TaxStub : 9
Pos -down-> AccStub : 10
Pos -down-> HRStub : 11
BO .down.> Pos : 12

legend bottom
  The numbers on the links refer to the table "Network links" in section 4.4.
  A scanned code is typed into the browser and reaches the POS application through the system API (AD-10).
  The register keeps selling when the network, the store database or an external system is down (QA-04).
endlegend
@enduml
