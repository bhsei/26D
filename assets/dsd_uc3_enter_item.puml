@startuml
' NewEra POS - Design sequence diagram: UC3 Process Rental, enter the item and choose the rental period (Contracts 13 and 14), W11 draft
' Team D - editable source of assets/dsd_uc3_enter_item.png
' Render with: java -jar plantuml.jar -charset UTF-8 -tpng assets/dsd_uc3_enter_item.puml
' Participants: classes of the logical view (architecture.md 4.2) and of the design class diagram skeleton. Operations: system_interfaces.md 3.4 and 4.3.
' Messages marked <<new>> are not in the logical view or in system_interfaces.md yet (sent to Borja for the design class diagram).

skinparam shadowing false
skinparam dpi 130
skinparam defaultFontName Arial
skinparam ArrowColor #444444
skinparam SequenceLifeLineBorderColor #444444
skinparam ParticipantBorderColor #1F4E79
skinparam ParticipantBackgroundColor #EAF1FB
skinparam BoxPadding 6
skinparam SequenceGroupBackgroundColor #F4F8FD
skinparam SequenceGroupBorderColor #1F4E79
skinparam SequenceDividerBackgroundColor #EAF1FB
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B8A04A
skinparam LegendBackgroundColor #FFFFFF
skinparam LegendBorderColor #1F4E79
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 190

title NewEra POS - Design sequence diagram: UC3 Process Rental, item and rental period (Contracts 13-14)

box "UI layer (ui.api)" #F4F8FD
  participant ":Rental\nController" as Ctl
end box
box "Application / domain layer" #F4F8FD
  participant ":Rental\nHandler" as H
  participant "rental:\nRental" as R
  participant "line:\nRentalLineItem" as L
  participant "item:\nItem" as I
  participant "pd:\nProductDescription" as PD
end box
box "application.interfaces" #F4F8FD
  participant ":ItemRepository" as Items
  participant ":StoreDatabase\nSync" as Sync
end box

== enterRentalItem(serialNumber) - Contract 13 ==
[-> Ctl : POST /api/rentals/{rentalID}/lines {"serialNumber"}
Ctl -> H : enterRentalItem(serialNumber)
H -> Items : findItem(serialNumber)
Items --> H : Optional<Item>
alt serial number not in the item list (7a)
  H --> Ctl : unknown item
  [<-- Ctl : 404 unknown serial number
else item found
  H -> I : isAvailable() <<new>>
  I --> H : status
  alt status Rented or Under maintenance (7b)
    H --> Ctl : not available, status
    [<-- Ctl : 409 item not Available, with its status (BR-11)
  else Available
    H -> Sync : putHold(serialNumber, rentalID)
    note right of Sync
      One row of item_hold in the store database;
      the serial number is unique (AD-05, SRS Q6).
    end note
    Sync --> H : HELD, HELD_BY_OTHER or NOT_AVAILABLE
    alt HELD_BY_OTHER (7b: on hold at another register)
      H --> Ctl : not available
      [<-- Ctl : 409 item not Available (on hold at another register)
    else HELD, or NOT_AVAILABLE (rent from the local copy; a conflict is found later)
      H -> R : addLine(item) <<new>>
      R -> L ** : create(item)
      note right of L
        Creator: the rental contains its lines.
        The period is not chosen yet.
      end note
      R --> H : line
      H -> I : description()
      I --> H : pd
      H -> PD : rentalData() <<new>>
      PD --> H : description, rental fee per day, deposit
      H --> Ctl : line data
      [<-- Ctl : 201 description, item status,\nrental fee per day, deposit
    end
  end
end

== selectRentalPeriod(days) - Contract 14 (also 8a: another period) ==
[-> Ctl : PUT /api/rentals/{rentalID}/lines/{lineNumber}/period {"days"}
Ctl -> H : selectRentalPeriod(lineNumber, days)
H -> R : setPeriod(lineNumber, days) <<new>>
R -> L : setPeriod(days) <<new>>
alt days is not 1, 3 or 7
  L --> R : invalid period
  R --> H : invalid period
  H --> Ctl : invalid period
  [<-- Ctl : 400 other period (BR-15)
else 1, 3 or 7 days
  L -> I : description()
  I --> L : pd
  L -> PD : rentalData() <<new>>
  PD --> L : rental fee per day, deposit
  L -> L : rentalPeriodDays = days\nrentalFee = fee per day x days\ndueDate = today + days (BR-15)\ndeposit = deposit of the product (BR-10)
  L --> R : rentalFee, dueDate, deposit
  R -> R : subtotal = sum of the rental fees
  R --> H : rentalFee, dueDate, deposit
  H --> Ctl : line data
  [<-- Ctl : 200 rental fee, due date, deposit
end

legend bottom left
  **GRASP**
  Controller: RentalController and RentalHandler, as in the start of the rental.
  Creator: Rental creates its RentalLineItems, because it contains them (Contract 13).
  Information Expert: Item knows its status (BR-11); ProductDescription knows the rental fee per day and the deposit;
  RentalLineItem calculates its fee and due date (BR-15); Rental adds the fees into its subtotal (Contract 14).
  Low Coupling, Protected Variations: the handler never reads the store database itself; the hold is one call of
  StoreDatabaseSync, and the handler chooses the fallback when it answers NOT_AVAILABLE (AD-05, AD-07).
endlegend
@enduml
