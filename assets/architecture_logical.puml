@startuml
' NewEra POS - Logical view (layers and packages), W09
' Team D - editable source of assets/architecture_logical.png
' Render with: java -jar plantuml.jar -tpng assets/architecture_logical.puml
' Names follow docs/design/architecture.md (AD-01 layers, AD-02 local web application, AD-04 adapters, AD-10 devices),
' the domain model, the SSDs and docs/design/system_interfaces.md.

!pragma layout smetana
set separator none
top to bottom direction
skinparam shadowing false
skinparam dpi 130
skinparam defaultFontName Arial
skinparam ArrowColor #444444
skinparam ArrowFontSize 11
skinparam PackageBorderColor #1F4E79
skinparam PackageBackgroundColor #EAF1FB
skinparam RectangleBorderColor #888888
skinparam RectangleBackgroundColor #FFFFFF
skinparam RectangleFontSize 11
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B8A04A

title NewEra POS - Logical view (AD-01)

package "UI layer" as UI {
  package "ui.screens (browser)" as screens {
    rectangle "Login · Menu · Sale · Payment · Receipt\nReturn · Rental · RentalReturn · Manager" as Screens
  }
  package "ui.api (POS application)" as api {
    rectangle "SessionController · SaleController · ReturnController\nRentalController · RentalReturnController · ManagerController" as Controllers
  }
}

package "Application / domain layer" as APP {
  package "application" as application {
    rectangle "SessionHandler · SaleHandler · ReturnHandler\nRentalHandler · RentalReturnHandler · ManagerHandler" as Handlers
  }
  package "application.interfaces" as interfaces {
    rectangle "<<interface>>\nPaymentService · TaxCalculator · AccountingSystem\nHRSystem · CatalogSource\nCardReader · ReceiptPrinter · CashDrawer · repositories" as Interfaces
  }
  package "domain.store" as dstore {
    rectangle "Store · Register\nEmployee · CashierSession" as DStore
  }
  package "domain.catalog" as dcatalog {
    rectangle "ProductCatalog\nProductDescription · Item" as DCatalog
  }
  package "domain.transactions" as dtrans {
    rectangle "Transaction · Sale · Return · Rental · RentalReturn\n(line items) · Customer · Receipt · AccountingRecord" as DTrans
  }
  package "domain.payments" as dpay {
    rectangle "Payment · CashPayment · CreditCardPayment\nCheckPayment · Refund" as DPay
  }
}

package "Technical services layer" as TECH {
  package "technical.external (one adapter per system)" as external {
    rectangle "PaymentServiceAdapter · TaxCalculatorAdapter\nAccountingSystemAdapter · HRSystemAdapter · CatalogFileImport" as Adapters
  }
  package "technical.devices (Device Service)" as devices {
    rectangle "CardReaderDriver · ReceiptPrinterDriver\nCashDrawerDriver" as Drivers
  }
  package "technical.storage" as storage {
    rectangle "TransactionRepository · ItemRepository\nAccountingQueue · EmployeeList" as Repos
  }
  package "technical.logging" as logging {
    rectangle "EventLog" as Log
  }
}

Screens -down-> Controllers : HTTP + JSON (localhost)
Controllers -down-> Handlers : system operations
Handlers -down-> DTrans
Handlers -down-> Interfaces
DTrans -[hidden]right- DPay
DStore -[hidden]right- DCatalog
DStore -[hidden]down- DTrans
Adapters -up-|> Interfaces : implements
Drivers -up-|> Interfaces : implements
Repos -up-|> Interfaces : implements
Adapters -down-> Log
Drivers -down-> Log

note right of Adapters
  Each adapter talks to the stub of its
  external system (DC-01) and returns
  NOT_AVAILABLE after its timeout (AD-07).
  A real system replaces the stub by
  changing only its adapter (DC-02).
end note

@enduml
