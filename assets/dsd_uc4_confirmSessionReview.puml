@startuml dsd_uc4_confirmSessionReview
title DSD UC4 Session Review - confirmSessionReview(sessionID, managerID, pin, reason) (Contract 29)
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceMessageAlign left
skinparam ParticipantPadding 10
skinparam BoxPadding 6
skinparam NoteBackgroundColor #FFFBE6
skinparam NoteBorderColor #B7791F
hide footbox
box "ui.api" #EAF2E3
  participant "ctrl:ManagerController" as C
end box
box "application" #E8EEF7
  participant "h:ManagerHandler" as H
  participant "ManagerApproval" as MA
end box
box "domain" #FFF7E0
  participant "store:Store" as ST
  participant "s:CashierSession" as S
end box
box "application.interfaces" #F2F2F2
  participant "hr:HRSystem" as HR
  participant "employees:EmployeeList" as EL
  participant "sync:StoreDatabaseSync" as SYNC
end box

[-> C : POST /api/sessions/{sessionID}/review\n{reason, manager{employeeID, pin}}
C -> C : check the format
C -> H : confirmSessionReview(sessionID, managerID, pin, reason)
alt reason is empty
  H --> C : ReviewResult(INVALID_REASON)
  C -->[ : 400
else reason given
  H -> MA : check(managerID, pin)
  MA -> HR : checkEmployee(managerID, pin)
  HR --> MA : EmployeeCheck
  opt NOT_AVAILABLE (UC4 6c4, IR-09)
    MA -> EL : find(managerID)
    EL --> MA : Optional<EmployeeEntry>
    MA -> MA : entry.isActiveStoreManager()\nand entry.pinMatches(pin)
  end
  alt manager not valid or wrong PIN
    MA --> H : ApprovalResult(REFUSED)
    H --> C : ReviewResult(NOT_APPROVED)
    C -->[ : 403, nothing changes
  else store manager valid
    MA -> ST : findEmployee(managerID)
    ST --> MA : manager
    MA --> H : ApprovalResult(OK, manager)
    H -> SYNC : findSessionToReview(sessionID)
    note right of SYNC : StoreDatabaseSync is the only class that talks\nto the store database (AD-05)
    SYNC --> H : SessionLookup(s | NOT_FOUND | NOT_AVAILABLE)
    alt store database not available (AD-05)
      H --> C : ReviewResult(STORE_NOT_AVAILABLE)
      C -->[ : 409 store database not available
    else no session with this ID
      H --> C : ReviewResult(NOT_FOUND)
      C -->[ : 404
    else session found
      H -> S : markReviewed(manager, reason, now)
      alt markReviewed refuses: toReview is already false (another store manager reviewed it first)
        H --> C : ReviewResult(NOT_TO_REVIEW)
        C -->[ : 409 the session is not to review any more, nothing changes
      else accepted
        note right of S : toReview = false\nreviewedBy = manager\nreviewReason = reason\nreviewedAt = now
        H -> SYNC : recordSessionReview(sessionID, managerID, reason)
        note right of SYNC : one store database transaction: the session is updated\nonly if to_review is still true at that moment
        SYNC --> H : StoreResult(OK | NOT_TO_REVIEW | NOT_AVAILABLE)
        alt StoreResult is NOT_AVAILABLE
          H --> C : ReviewResult(STORE_NOT_AVAILABLE)
          C -->[ : 409 (the copy of the session is discarded)
        else StoreResult is NOT_TO_REVIEW (a review from another register was faster)
          H --> C : ReviewResult(NOT_TO_REVIEW)
          C -->[ : 409 (the copy of the session is discarded)
        else OK
          H --> C : ReviewResult(OK)
          C -->[ : 200 review recorded (reviewer, time and reason are saved in the store database)
        end
      end
    end
  end
end
note over MA : The pin is dropped after the check:\nnever stored, logged or returned (NFR-08)
@enduml