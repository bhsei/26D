@startuml
' NewEra POS - Design class diagram, skeleton 2 of 3: domain classes (names only), W11
' Team D - editable source of assets/design_classes_domain.png
' Render with: java -jar plantuml.jar -tpng -charset UTF-8 assets/design_classes_domain.puml
' Sources: logical view (architecture.md 4.2), domain model v0.7, AD-08, system_interfaces.md v0.5.
' The skeleton has class names, packages and the main links. Attributes and methods are added from the
' design sequence diagrams (Mon 23 Nov). The UI screens are in assets/ui_classes.puml (ui_design.md 4).

set separator none
skinparam shadowing false
skinparam dpi 110
skinparam defaultFontName Arial
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 55
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B8A04A
skinparam class {
  BackgroundColor<<controller>> #EAF6EA
  BorderColor<<controller>> #2E7D32
  BackgroundColor<<handler>> #F4F8FD
  BorderColor<<handler>> #1F4E79
  BackgroundColor<<payment>> #EAF1FB
  BorderColor<<payment>> #1F4E79
  BackgroundColor<<domain>> #FFFFFF
  BorderColor<<domain>> #666666
}
hide circle
hide members
left to right direction

title NewEra POS - Design class diagram (skeleton 2 of 3): domain classes

package "domain.store" {
  class Store <<domain>>
  class Register <<domain>>
  class Employee <<domain>>
  class CashierSession <<domain>>
}
package "domain.catalog" {
  class ProductCatalog <<domain>>
  class ProductDescription <<domain>>
  class Item <<domain>>
}
package "domain.transactions" {
  abstract class Transaction <<domain>>
  class Sale <<domain>>
  class SaleLineItem <<domain>>
  class Return <<domain>>
  class ReturnLineItem <<domain>>
  class Rental <<domain>>
  class RentalLineItem <<domain>>
  class RentalReturn <<domain>>
  class Customer <<domain>>
  class Receipt <<domain>>
  class AccountingRecord <<domain>>
}
package "domain.payments" {
  abstract class Payment <<domain>>
  class CashPayment <<domain>>
  class CreditCardPayment <<domain>>
  class CheckPayment <<domain>>
  class Refund <<domain>>
}

' ---------- domain (as in the domain model v0.7) ----------
Transaction <|-- Sale
Transaction <|-- Return
Transaction <|-- Rental
Transaction <|-- RentalReturn
Payment <|-- CashPayment
Payment <|-- CreditCardPayment
Payment <|-- CheckPayment
Store "1" -- "1..*" Register
Store "1" -- "1" ProductCatalog
Store "1" -- "*" Employee
Register "1" -- "*" CashierSession
Employee "1" -- "*" CashierSession : opens
CashierSession "*" -- "0..1" Employee : reviewed by
CashierSession "1" -- "*" Transaction : records
ProductCatalog "1" o-- "*" ProductDescription
ProductDescription "1" -- "*" Item
Sale "1" *-- "1..*" SaleLineItem
SaleLineItem "*" -- "1" ProductDescription
Return "*" -- "1" Sale : returns items of
Return "1" *-- "1..*" ReturnLineItem
ReturnLineItem "*" -- "1" SaleLineItem
Rental "*" -- "1" Customer
Rental "1" *-- "1..*" RentalLineItem
RentalLineItem "*" -- "1" Item
RentalReturn "0..1" -- "1" RentalLineItem : closes
Transaction "1" -- "0..1" Payment
Return "1" -- "0..1" Refund
RentalReturn "1" -- "0..1" Refund
Transaction "1" -- "*" Receipt
Transaction "1" -- "0..1" AccountingRecord

@enduml
